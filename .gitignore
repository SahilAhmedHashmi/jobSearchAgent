# Share source only. New files are ignored unless deliberately allowed here.
*
!/.gitignore
!/AGENTS.md
!/GEMINI.md
!/README.md
!/SEARCH_PREFERENCES.md
!/pyproject.toml
!/main.py
!/job_agent/
!/job_agent/*.py
!/tests/
!/tests/test_*.py
!/examples/
!/examples/resume.txt

# Defense in depth: never force-add personal/runtime artifacts.
**/data/
**/reports/
**/results/
**/plans/
**/profiles/
**/resumes/
**/uploads/
**/archive/
**/backups/
**/.env*
**/*secret*
**/*credential*
**/*.pdf
**/*.docx
**/*.doc
**/*.csv
**/*.json
**/*.jsonl
**/*.sqlite*
**/*.db*
**/*.log
**/*.zip
**/*.7z
**/*.bak
**/*.pem
**/*.key
**/__pycache__/
**/.pytest_cache/
**/.venv/
**/*.egg-info/
**/*.pyc
